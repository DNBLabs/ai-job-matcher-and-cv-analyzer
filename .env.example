# Application (local Docker Compose)
DATABASE_URL=postgresql+psycopg://jobmatcher:jobmatcher@127.0.0.1:5432/jobmatcher
APP_ENV=development

# Comma-separated browser origins for CORS (restrict in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API
API_HOST=0.0.0.0
API_PORT=8000

# Session signing secret (required before Task 3 auth — generate with: openssl rand -hex 32)
# SESSION_SECRET=

# Frontend dev server (optional; production build served by API in later tasks)
VITE_API_BASE_URL=http://localhost:8000

# Infrastructure ports (Task 1 — local Docker Compose uses emulators)
# BLOB_STORE_BACKEND=memory
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# BLOB_CONTAINER_NAME=cvs
# BLOB_KEY_PREFIX=cvs/
# JOB_QUEUE_BACKEND=in_process
# RABBITMQ_URL=amqp://jobmatcher:jobmatcher@localhost:5672/
# JOB_QUEUE_NAME=analysis-runs
# SECRET_PROVIDER_BACKEND=env

# Secrets — use real values only in local .env (never commit)
# Loaded into os.environ at API startup for SecretProvider (GOOGLE_OAUTH_* etc.)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# POST_AUTH_REDIRECT_URL=http://localhost:5173/dashboard
# OPENAI_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# EMAIL_API_KEY=
