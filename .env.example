# Application (local Docker Compose)
DATABASE_URL=postgresql://jobmatcher:jobmatcher@localhost:5432/jobmatcher
APP_ENV=development

# Comma-separated browser origins for CORS (restrict in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# API
API_HOST=0.0.0.0
API_PORT=8000

# Session signing secret (required before Task 3 auth — generate with: openssl rand -hex 32)
# SESSION_SECRET=

# Frontend dev server (optional; production build served by API in later tasks)
VITE_API_BASE_URL=http://localhost:8000

# Secrets — use real values only in local .env (never commit)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# OPENAI_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# EMAIL_API_KEY=
